# ===================================================
# BizManager Backend - Environment Variables
# ===================================================
# Copy this file to .env and fill in your values
# For Gmail: Enable 2FA, then create an App Password at
# https://myaccount.google.com/apppasswords
# ===================================================

# SMTP Email Configuration (for password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=BizManager

# Frontend URL (used in reset email links)
FRONTEND_URL=http://localhost:5173

# JWT Secret Key (change in production!)
JWT_SECRET_KEY=bizmanager-secret-key-change-in-production
